{
  "name": "report_app - Flutter and .NET 10",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [5107, 5173],
  "portsAttributes": {
    "5107": {
      "label": ".NET Web API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Flutter Web",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp"
      ]
    }
  }
}